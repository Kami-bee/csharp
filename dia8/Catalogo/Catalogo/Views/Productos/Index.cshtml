@namespace Catalogo.Models
@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}
<h1>Catalogo de productos</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Codigo</th>
            <th>Producto</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Producto p in Model)
        {
            <tr>
                <td>@p.Codigo</td>
                <td>@p.Nombre</td>
                <td>@p.Categoria</td>
                <td>@p.PrecioVenta.ToString("NO") Gs</td>
                <td>@p.Stock</td>
            </tr>
        }
    </tbody>
</table>
