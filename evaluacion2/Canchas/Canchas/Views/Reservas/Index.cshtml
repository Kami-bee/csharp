@model List<Reserva>
@{
    ViewData["Title"] = "Reservas";
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Reservas de canchas</h1>
            <p class="text-muted mb-0">Administra y consulta todas las reservas.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Nueva reserva
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Resumen -->
    <h5 class="fw-bold mb-3">Resumen general</h5>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Reservas confirmadas</p>
                        <h2 class="fw-bold text-success mb-0">@ViewBag.Confirmadas</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-check-circle text-success fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Reservas de hoy</p>
                        <h2 class="fw-bold text-primary mb-0">@ViewBag.ReservasHoy</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-calendar-check text-primary fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Ingresos confirmados</p>
                        <h2 class="fw-bold text-dark mb-0 fs-3">@ViewBag.Ingresos.ToString("N0")</h2>
                        <small class="text-muted">Guaraníes (Gs.)</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-cash-stack text-warning fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Canchas activas</p>
                        <h2 class="fw-bold text-info mb-0">@ViewBag.CanchasActivas</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-dribbble text-info fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Tabla de reservas -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul me-2 text-primary"></i>
                Listado de reservas
            </h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th class="px-3 py-3">Cancha</th>
                        <th class="py-3">Cliente</th>
                        <th class="py-3">Inicio</th>
                        <th class="py-3">Fin</th>
                        <th class="py-3">Total</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3 text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (Reserva r in Model)
                    {
                        <tr>
                            <td class="px-3 py-3">
                                <div class="fw-semibold">@r.Cancha?.Nombre</div>
                                <small class="text-muted">@r.Cancha?.Tipo</small>
                            </td>

                            <td class="py-3">
                                <div class="fw-semibold">@r.Cliente?.Nombre</div>
                                <small class="text-muted">
                                    <i class="bi bi-telephone me-1"></i>
                                    @r.Cliente?.Telefono
                                </small>
                            </td>

                            <td class="py-3">
                                <div class="fw-medium">@r.Inicio.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">
                                    @r.Inicio.ToString("HH:mm") hs
                                </small>
                            </td>

                            <td class="py-3">
                                <div class="fw-medium">@r.Fin.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">
                                    @r.Fin.ToString("HH:mm") hs
                                </small>
                            </td>

                            <td class="py-3 fw-semibold text-nowrap">
                                @r.Total.ToString("N0") Gs.
                            </td>

                            <td class="py-3">
                                @if (r.Estado == "Confirmada")
                                {
                                    <span class="badge rounded-pill bg-success px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>
                                        @r.Estado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3 py-2">
                                        @r.Estado
                                    </span>
                                }
                            </td>

                            <td class="py-3">
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Edit" asp-route-id="@r.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Editar reserva">
                                        <i class="bi bi-pencil-square"></i>
                                        Editar
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" onsubmit="return confirm('¿Eliminar esta reserva?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar reserva">
                                            <i class="bi bi-trash"></i>
                                            Eliminar
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>
